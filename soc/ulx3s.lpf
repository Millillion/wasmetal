# Same documented ULX3S 85F pins as fpga/ulx3s.lpf; independent boot clock.
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;
FREQUENCY NET "core_clock" 0.78125 MHZ;
LOCATE COMP "btn_n" SITE "D6";
IOBUF PORT "btn_n" PULLMODE=UP IO_TYPE=LVCMOS33;
LOCATE COMP "ftdi_rxd" SITE "L4";
IOBUF PORT "ftdi_rxd" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led_busy" SITE "B2";
IOBUF PORT "led_busy" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led_error" SITE "C2";
IOBUF PORT "led_error" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
