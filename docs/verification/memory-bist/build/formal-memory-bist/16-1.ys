read_verilog -formal -sv -DWASMETAL_ASSERTIONS /tmp/wasmetal-xc7-core/build/formal-memory-bist/memory_bist.sv
chparam -set RAM_BYTES 16 -set RESPONSE_TIMEOUT 1 wasmetal_memory_bist
prep -top wasmetal_memory_bist -flatten
memory_map
opt_clean
sat -seq 1 -tempinduct -maxsteps 24 -set-assumes -set-def-inputs -set-init-undef -enable_undef -prove-asserts -verify
