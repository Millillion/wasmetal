read_verilog -formal -sv -DWASMETAL_ASSERTIONS /tmp/wasmetal-xc7-core/build/formal-memory-startup/wasmetal_memory_bist.sv /tmp/wasmetal-xc7-core/build/formal-memory-startup/early-handoff.sv
chparam -set RAM_BYTES 32 -set RESPONSE_TIMEOUT 2 wasmetal_memory_startup
prep -top wasmetal_memory_startup -flatten
memory_map
opt_clean
sat -seq 12 -set-assumes -set-def-inputs -set-init-undef -enable_undef -prove-asserts -verify
